PORT=3000

# Flash sale window (ISO timestamps). If unset, defaults to an active window relative to
# "now" (1 hour ago -> 24 hours from now) — see src/config.ts.
# SALE_START=2026-09-24T00:00:00.000Z
# SALE_END=2026-09-25T00:00:00.000Z
STOCK_QUANTITY=100

# LocalStack
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

INVENTORY_TABLE=Inventory
PURCHASES_TABLE=Purchases
PURCHASE_QUEUE_NAME=flash-sale-purchases
